@inherits LayoutComponentBase

<PageTitle>Employee Management System</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: row;
    }

    .sidebar {
        background-color: #f8f9fa;
    }

    main {
        flex: 1;
        background-color: #fff;
        min-height: 100vh;
    }

    .content {
        padding-top: 1.5rem;
    }

    @@media (max-width: 640.98px) {
        .page {
            flex-direction: column;
        }

        .sidebar {
            width: 100%;
            height: 3.5rem;
        }

        main {
            flex: 1;
        }
    }

    @@media (min-width: 641px) {
        .sidebar {
            width: 250px;
            height: 100vh;
            position: sticky;
            top: 0;
        }

        .main {
            padding-left: 2rem;
            padding-right: 1.5rem;
        }
    }
</style>
