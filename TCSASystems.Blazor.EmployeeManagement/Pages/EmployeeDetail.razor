@page "/employee/{Id:int}"
@using TCSASystems.Blazor.EmployeeManagement.Models
@using TCSASystems.Blazor.EmployeeManagement.Services
@inject IEmployeeService EmployeeService
@inject NavigationManager NavigationManager

<PageTitle>Employee Details</PageTitle>

<div class="container mt-4">
    <h3>Employee Details</h3>

    @if (ShowWarning)
    {
        <div class="alert @(Warning_Type == WarningType.Success ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Warning_Message
            <button type="button" class="btn-close" @onclick="DismissWarning"></button>
        </div>
    }

    @if (employee == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        @if (!string.IsNullOrEmpty(employee.ImgUrl))
                        {
                            <img src="@employee.ImgUrl" class="img-fluid rounded" alt="Employee Photo" />
                        }
                        else
                        {
                            <div class="text-center p-4 bg-light rounded">
                                <i class="bi bi-person-circle" style="font-size: 8rem;"></i>
                            </div>
                        }
                    </div>
                    <div class="col-md-8">
                        <h4>@employee.Name</h4>
                        <p class="text-muted">@employee.Position.GetDisplayName()</p>
                        <hr />
                        <dl class="row">
                            <dt class="col-sm-4">Employment Type</dt>
                            <dd class="col-sm-8">@employee.Type.GetDisplayName()</dd>

                            <dt class="col-sm-4">Hourly Rate</dt>
                            <dd class="col-sm-8">$@employee.HourlyRate</dd>

                            @if (employee.Salary.HasValue)
                            {
                                <dt class="col-sm-4">Salary</dt>
                                <dd class="col-sm-8">$@employee.Salary</dd>
                            }
                        </dl>
                        <div class="mt-3">
                            <button class="btn btn-primary me-2" @onclick="() => EditEmployee(employee.Id)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteEmployee(employee.Id)">Delete</button>
                            <button class="btn btn-secondary ms-2" @onclick="() => NavigationManager.NavigateTo(@"/")">Back</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Employee? employee;
    private bool ShowWarning = false;
    private string Warning_Message = "";
    private WarningType Warning_Type;

    protected override async Task OnInitializedAsync()
    {
        var response = await EmployeeService.GetEmployeeById(Id);
        if (response.StatusCode == 200)
        {
            employee = response.Data;
        }
        else
        {
            Warning_Type = WarningType.Error;
            Warning_Message = response.Message;
            ShowWarning = true;
        }
    }

    private async Task DeleteEmployee(int id)
    {
        var response = await EmployeeService.DeleteEmployee(id);
        Warning_Type = response.StatusCode == 200 ? WarningType.Success : WarningType.Error;
        Warning_Message = response.Message;
        ShowWarning = true;

        if (response.StatusCode == 200)
        {
            await Task.Delay(2000); // Show success message for 2 seconds
            NavigationManager.NavigateTo("/");
        }
    }

    private void EditEmployee(int id)
    {
        NavigationManager.NavigateTo($"/edit-employee/{id}");
    }

    private void DismissWarning()
    {
        ShowWarning = false;
    }
}