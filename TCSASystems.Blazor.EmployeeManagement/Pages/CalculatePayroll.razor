@page "/calculate-payroll"
@using TCSASystems.Blazor.EmployeeManagement.Models
@using static TCSASystems.Blazor.EmployeeManagement.Components.Warning;
@inject IJSRuntime JS

@if (ShowWarning)
{
    <Warning OnClickCallback="DismissWarning" Type=@Warning_Type Message="@Warning_Message" />
}
else
{
    <Card>
        <div class="row user-detail-row">
            <h3>Calculate Payroll</h3>
            <div class="form-group">
                <div class="form-floating mb-3">
                    <InputSelect shadow rounded id="floatingInput" placeholder="Select Employee" @bind-Value="selectedEmployeeId" class="form-select">
                        <option value="">Select an employee</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@employee.Name - @employee.Type.GetDisplayName() @employee.Position.GetDisplayName()</option>
                        }
                    </InputSelect>
                    <label for="floatingInput">Select Employee</label>
                </div>

                @if (selectedEmployeeId > 0)
                {
                    var employee = employees.FirstOrDefault(e => e.Id == selectedEmployeeId);
                    if (employee != null)
                    {
                        <div class="alert alert-info">
                            <p>Employee: @employee.Name</p>
                            <p>Position: @employee.Position.GetDisplayName()</p>
                            <p>Type: @employee.Type.GetDisplayName()</p>
                            <p>Hourly Rate: $@employee.HourlyRate</p>
                        </div>

                        <div class="form-floating mb-3">
                            <InputNumber class="form-control" id="floatingInput" placeholder="Hours Worked" @bind-Value="hoursWorked" />
                            <label for="floatingInput">Hours Worked</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="CalculateEmployeePayroll">Calculate Payroll</button>
                            @if (calculatedPayroll > 0)
                            {
                                <button class="btn btn-success" @onclick="ExportToExcel" disabled="@IsExporting">
                                    @if (IsExporting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>Exporting...</span>
                                    }
                                    else
                                    {
                                        <span>Export to Excel</span>
                                    }
                                </button>
                            }
                        </div>

                        @if (calculatedPayroll > 0)
                        {
                            <div class="alert alert-success mt-3">
                                <h4>Payroll Calculation</h4>
                                <p>Hours Worked: @hoursWorked</p>
                                <p>Hourly Rate: $@employee.HourlyRate</p>
                                @if (employee.Type == EmployeeType.FullTime && hoursWorked > 40)
                                {
                                    <p>Regular Hours: 40</p>
                                    <p>Overtime Hours: @(hoursWorked - 40)</p>
                                    <p>Overtime Rate: $@(employee.HourlyRate * 1.5m)</p>
                                }
                                <p><strong>Total Pay: $@calculatedPayroll</strong></p>
                            </div>
                        }
                    }
                }

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        @ErrorMessage
                    </div>
                }
            </div>
        </div>
    </Card>
}

@code {
    [Inject] private IEmployeeService EmployeeService { get; set; }
    [Inject] private IPayrollService PayrollService { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool ShowWarning = false;
    private string Warning_Message = "";
    private WarningType Warning_Type;
    private List<Employee> employees = new();
    private int selectedEmployeeId;
    private int hoursWorked;
    private decimal calculatedPayroll;
    private bool IsExporting { get; set; }
    private string ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await EmployeeService.GetEmployees();
        if (response.StatusCode == 200 && response.Employees != null)
        {
            employees = response.Employees;
        }
        else
        {
            ShowWarning = true;
            Warning_Type = WarningType.Error;
            Warning_Message = "Failed to load employees";
        }
    }

    private void CalculateEmployeePayroll()
    {
        var employee = employees.FirstOrDefault(e => e.Id == selectedEmployeeId);
        if (employee != null)
        {
            calculatedPayroll = PayrollService.CalculatePayroll(employee, hoursWorked);
            ErrorMessage = null;
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var employee = employees.FirstOrDefault(e => e.Id == selectedEmployeeId);
            if (employee == null) return;

            IsExporting = true;
            ErrorMessage = null;

            // Create a single attendance record for this calculation
            var attendance = new Attendance
            {
                Employee = employee,
                EmployeeId = employee.Id,
                Date = DateTime.Today,
                CheckIn = TimeOnly.FromTimeSpan(TimeSpan.FromHours(9)), // 9 AM start
                CheckOut = TimeOnly.FromTimeSpan(TimeSpan.FromHours(9 + hoursWorked)) // Add worked hours
            };

            var excelBytes = PayrollService.GeneratePayrollExcel(new List<Attendance> { attendance }, DateTime.Today, DateTime.Today);
            var fileName = $"Payroll_Calculation_{employee.Name}_{DateTime.Now:yyyyMMdd}.xlsx";
            var base64 = Convert.ToBase64String(excelBytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to export payroll: {ex.Message}";
        }
        finally
        {
            IsExporting = false;
        }
    }

    private void DismissWarning()
    {
        ShowWarning = false;
    }
} 