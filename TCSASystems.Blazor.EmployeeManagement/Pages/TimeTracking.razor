@page "/timetracking"
@using TCSASystems.Blazor.EmployeeManagement.Services
@using TCSASystems.Blazor.EmployeeManagement.Models
@using Microsoft.EntityFrameworkCore
@inject IEmployeeService EmployeeService
@inject IAttendanceService AttendanceService
@inject NavigationManager NavigationManager

<style>
    .page-title {
        color: #2d3748;
        font-size: 1.875rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .calendar-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .calendar-header {
        background-color: #f8fafc;
        padding: 1.25rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .calendar {
        width: 100%;
        border-collapse: separate;
        border-spacing: 8px;
        padding: 16px;
    }

    .calendar th {
        padding: 12px;
        text-align: center;
        font-weight: 600;
        color: #4a5568;
        font-size: 0.875rem;
    }

    .calendar td {
        position: relative;
        width: calc(100% / 7);
        padding: 0;
        vertical-align: top;
    }

    .calendar-day {
        position: relative;
        min-height: 100px;
        padding: 12px;
        background-color: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .calendar-day:hover {
        transform: translateY(-2px);
        border-color: #4299e1;
        box-shadow: 0 8px 16px rgba(66, 153, 225, 0.2);
    }

    .calendar-day.other-month {
        background-color: #f8fafc;
        color: #a0aec0;
    }

    .calendar-day.today {
        background-color: #ebf8ff;
        border: 2px solid #4299e1;
    }

    .calendar-day.has-attendance {
        border-left: 4px solid #48bb78;
    }

    .calendar-day.late-attendance {
        border-left: 4px solid #ecc94b;
    }

    .day-number {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 8px;
    }

    .attendance-info {
        font-size: 0.875rem;
        color: #4a5568;
        background-color: #f7fafc;
        padding: 4px 8px;
        border-radius: 8px;
        margin-top: 4px;
    }

    .attendance-time {
        display: block;
        margin-top: 4px;
        font-size: 0.75rem;
        color: #718096;
    }

    .form-container {
        background-color: white;
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        color: #4a5568;
        font-weight: 500;
        font-size: 0.875rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.2s ease;
        font-size: 1rem;
    }

    .form-control:focus {
        outline: none;
        border-color: #4299e1;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
    }

    .form-select {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.2s ease;
        font-size: 1rem;
        background-color: white;
        cursor: pointer;
    }

    .form-select:focus {
        outline: none;
        border-color: #4299e1;
        box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
    }

    .btn-save {
        width: 100%;
        padding: 0.875rem;
        background-color: #4299e1;
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-save:hover {
        background-color: #3182ce;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px rgba(66, 153, 225, 0.2);
    }

    .btn-save:disabled {
        background-color: #a0aec0;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .recent-records {
        background-color: white;
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-top: 1.5rem;
    }

    .recent-records-header {
        padding: 1rem 1.5rem;
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .recent-record-item {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

    .recent-record-item:last-child {
        border-bottom: none;
    }

    .recent-record-item:hover {
        background-color: #f7fafc;
    }

    .badge {
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-weight: 500;
        font-size: 0.75rem;
    }

    .badge-success {
        background-color: #c6f6d5;
        color: #2f855a;
    }

    .badge-warning {
        background-color: #fefcbf;
        color: #975a16;
    }

    .alert {
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
    }

    .alert-success {
        background-color: #c6f6d5;
        color: #2f855a;
        border-left: 4px solid #48bb78;
    }

    .alert-error {
        background-color: #fed7d7;
        color: #c53030;
        border-left: 4px solid #f56565;
    }

    .alert-debug {
        background-color: #e2e8f0;
        color: #4a5568;
        font-family: monospace;
        white-space: pre-wrap;
        border-left: 4px solid #718096;
    }

    .nav-button {
        padding: 0.5rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        background-color: white;
        color: #4a5568;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .nav-button:hover {
        background-color: #f7fafc;
        border-color: #4299e1;
        color: #4299e1;
    }

    .month-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2d3748;
    }
</style>

<div class="container-fluid py-4">
    <h1 class="page-title">Time Tracking</h1>

    @if (ErrorMessage != null)
    {
        <div class="alert alert-error">
            <div>
                <strong>Error:</strong> @ErrorMessage
                @if (DebugMessage != null)
                {
                    <div class="mt-2 text-sm">
                        <strong>Debug Info:</strong>
                        <pre class="mt-1">@DebugMessage</pre>
                    </div>
                }
            </div>
        </div>
    }

    @if (SuccessMessage != null)
    {
        <div class="alert alert-success">
            @SuccessMessage
        </div>
    }

    @if (Employees == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!Employees.Any())
    {
        <div class="alert alert-warning">
            <div>
                <strong>No employees found.</strong>
                <p class="mb-0">Please add employees before recording attendance.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="calendar-container">
                    <div class="calendar-header d-flex justify-content-between align-items-center">
                        <h2 class="month-title mb-0">@CurrentMonth.ToString("MMMM yyyy")</h2>
                        <div class="d-flex gap-2">
                            <button class="nav-button" @onclick="PreviousMonth">&larr; Previous</button>
                            <button class="nav-button" @onclick="NextMonth">Next &rarr;</button>
                        </div>
                    </div>
                    <div class="calendar-body p-4">
                        <table class="calendar">
                            <thead>
                                <tr>
                                    <th>Sun</th>
                                    <th>Mon</th>
                                    <th>Tue</th>
                                    <th>Wed</th>
                                    <th>Thu</th>
                                    <th>Fri</th>
                                    <th>Sat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int week = 0; week < 6; week++)
                                {
                                    <tr>
                                        @for (int day = 0; day < 7; day++)
                                        {
                                            var date = CalendarDays[week * 7 + day];
                                            var attendance = date.HasValue ? GetAttendanceForDate(date.Value) : null;
                                            <td>
                                                @if (date.HasValue)
                                                {
                                                    <div class="calendar-day @GetDayCellClass(date, attendance)">
                                                        <div class="day-number">@date.Value.Day</div>
                                                        @if (attendance != null)
                                                        {
                                                            <div class="attendance-info">
                                                                <div>@attendance.CheckIn.ToString("HH:mm")</div>
                                                                @if (attendance.CheckOut.HasValue)
                                                                {
                                                                    <div>@attendance.CheckOut.Value.ToString("HH:mm")</div>
                                                                }
                                                                <div class="attendance-time">
                                                                    @attendance.HoursWorked.ToString("F1")h
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="form-container mb-4">
                    <h3 class="mb-4">Record Attendance</h3>
                    <EditForm Model="@NewAttendance" OnValidSubmit="@SaveAttendance">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-group">
                            <label class="form-label">Employee</label>
                            <select class="form-select" @bind="SelectedEmployeeId" @bind:event="oninput" @onchange="OnEmployeeSelected">
                                <option value="0">Select an employee...</option>
                                @foreach (var employee in Employees)
                                {
                                    <option value="@employee.Id">@employee.Name (@employee.Position.GetDisplayName())</option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Date</label>
                            <InputDate class="form-control" @bind-Value="DateValue" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Check In Time</label>
                            <input type="time" class="form-control" @bind="CheckInValue" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Check Out Time (Optional)</label>
                            <input type="time" class="form-control" @bind="CheckOutValue" />
                        </div>

                        <button type="submit" class="btn-save" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Save Attendance
                        </button>
                    </EditForm>
                </div>

                @if (RecentAttendances?.Any() == true)
                {
                    <div class="recent-records">
                        <div class="recent-records-header">
                            <h3 class="mb-0 h5">Recent Records</h3>
                        </div>
                        <div class="recent-records-body">
                            @foreach (var attendance in RecentAttendances.Take(5))
                            {
                                <div class="recent-record-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">@attendance.Date.ToString("MMM dd")</div>
                                            <div class="text-muted">
                                                @attendance.CheckIn.ToString("HH:mm") - @(attendance.CheckOut?.ToString("HH:mm") ?? "---")
                                            </div>
                                        </div>
                                        <span class="badge @(attendance.IsLate ? "badge-warning" : "badge-success")">
                                            @(attendance.IsLate ? "Late" : "On Time")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Employee>? Employees { get; set; }
    private int SelectedEmployeeId { get; set; }
    private Attendance NewAttendance { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? DebugMessage { get; set; }
    private bool IsSaving { get; set; }
    private List<Attendance>? RecentAttendances { get; set; }
    private DateTime CurrentMonth { get; set; } = DateTime.Today;
    private DateTime?[] CalendarDays { get; set; } = new DateTime?[42]; // 6 weeks * 7 days
    private Dictionary<DateTime, Attendance> AttendanceByDate { get; set; } = new();

    private DateTime? DateValue { get; set; }
    private TimeOnly? CheckInValue { get; set; }
    private TimeOnly? CheckOutValue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await EmployeeService.GetEmployees();
            if (response.StatusCode == 200 && response.Employees != null)
            {
                Employees = response.Employees;
            }
            UpdateCalendar();
        }
        catch (DbUpdateException ex)
        {
            ErrorMessage = "Database connection error. Please check if MySQL is running.";
            DebugMessage = $"Database Error: {ex.Message}\nInner Exception: {ex.InnerException?.Message}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load employees.";
            DebugMessage = ex.Message;
        }
    }

    private async Task OnEmployeeSelected()
    {
        if (SelectedEmployeeId == 0)
        {
            RecentAttendances = null;
            AttendanceByDate.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            RecentAttendances = await AttendanceService.GetAttendancesByEmployeeId(SelectedEmployeeId);
            UpdateAttendanceDictionary();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load attendance records.";
            DebugMessage = ex.Message;
        }
    }

    private void UpdateAttendanceDictionary()
    {
        AttendanceByDate.Clear();
        if (RecentAttendances != null)
        {
            foreach (var attendance in RecentAttendances)
            {
                AttendanceByDate[attendance.Date.Date] = attendance;
            }
        }
    }

    private void UpdateCalendar()
    {
        var firstDayOfMonth = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);
        var firstDayOfCalendar = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);

        for (int i = 0; i < 42; i++)
        {
            var date = firstDayOfCalendar.AddDays(i);
            CalendarDays[i] = (date.Month == CurrentMonth.Month) ? date : null;
        }
    }

    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        UpdateCalendar();
        StateHasChanged();
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        UpdateCalendar();
        StateHasChanged();
    }

    private string GetDayCellClass(DateTime? date, Attendance? attendance)
    {
        var classes = new List<string> { "text-center" };

        if (!date.HasValue)
        {
            classes.Add("bg-light");
            return string.Join(" ", classes);
        }

        if (date.Value.Month != CurrentMonth.Month)
        {
            classes.Add("text-muted");
        }

        if (attendance != null)
        {
            classes.Add(attendance.IsLate ? "bg-warning bg-opacity-25" : "bg-success bg-opacity-25");
        }

        return string.Join(" ", classes);
    }

    private Attendance? GetAttendanceForDate(DateTime date)
    {
        return AttendanceByDate.TryGetValue(date.Date, out var attendance) ? attendance : null;
    }

    private async Task SaveAttendance()
    {
        if (IsSaving) return;

        ErrorMessage = null;
        SuccessMessage = null;
        DebugMessage = null;
        IsSaving = true;

        try
        {
            // Validate form values
            if (SelectedEmployeeId == 0)
            {
                ErrorMessage = "Please select an employee.";
                return;
            }

            if (!DateValue.HasValue)
            {
                ErrorMessage = "Please select a date.";
                return;
            }

            if (!CheckInValue.HasValue)
            {
                ErrorMessage = "Please enter check-in time.";
                return;
            }

            if (CheckOutValue.HasValue && CheckOutValue.Value <= CheckInValue.Value)
            {
                ErrorMessage = "Check-out time must be after check-in time.";
                return;
            }

            // Create new attendance record
            var attendance = new Attendance
            {
                EmployeeId = SelectedEmployeeId,
                Date = DateValue.Value,
                CheckIn = CheckInValue.Value,
                CheckOut = CheckOutValue
            };

            // Save the attendance record
            await AttendanceService.AddAttendance(attendance);
            
            // Show success message
            SuccessMessage = "Attendance record saved successfully!";

            // Reset form
            ResetForm();

            // Refresh recent attendance records and update calendar
            await RefreshAttendanceData();
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (DbUpdateException ex)
        {
            ErrorMessage = "Database error occurred while saving attendance.";
            DebugMessage = $"Database Error: {ex.Message}\nInner Exception: {ex.InnerException?.Message}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred while saving the attendance record.";
            DebugMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        DateValue = null;
        CheckInValue = null;
        CheckOutValue = null;
    }

    private async Task RefreshAttendanceData()
    {
        if (SelectedEmployeeId > 0)
        {
            // Fetch updated records
            RecentAttendances = await AttendanceService.GetAttendancesByEmployeeId(SelectedEmployeeId);
            
            // Update the attendance dictionary with new data
            UpdateAttendanceDictionary();
            
            // Update calendar to reflect changes
            UpdateCalendar();
            
            // Force UI refresh
            await InvokeAsync(StateHasChanged);
        }
    }
}