@page "/timetracking"
@using TCSASystems.Blazor.EmployeeManagement.Models
@using Microsoft.EntityFrameworkCore
@inject IEmployeeService EmployeeService
@inject IAttendanceService AttendanceService
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <h3 class="mb-4">Time Tracking</h3>

    @if (ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ErrorMessage
            @if (DebugMessage != null)
            {
                <div class="mt-2 small text-muted">
                    Debug Info: @DebugMessage
                </div>
            }
        </div>
    }

    @if (SuccessMessage != null)
    {
        <div class="alert alert-success">
            @SuccessMessage
        </div>
    }

    @if (Employees == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!Employees.Any())
    {
        <div class="alert alert-warning">
            No employees found. Please add employees first.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <form @onsubmit:preventDefault>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="employee" class="form-label">Select Employee:</label>
                            <select id="employee" class="form-select" @bind="SelectedEmployeeId">
                                <option value="0">Select an employee...</option>
                                @foreach (var employee in Employees)
                                {
                                    <option value="@employee.Id">@employee.Name (@employee.Position.GetDisplayName())</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="date" class="form-label">Date:</label>
                            <input type="date" id="date" class="form-control" @bind="DateValue" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="checkin" class="form-label">Check In Time:</label>
                            <input type="time" id="checkin" class="form-control" @bind="CheckInValue" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="checkout" class="form-label">Check Out Time (Optional):</label>
                            <input type="time" id="checkout" class="form-control" @bind="CheckOutValue" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="submit" class="btn btn-primary" @onclick="SaveAttendance" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Save Attendance
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="ResetForm">Reset Form</button>
                    </div>
                </form>
            </div>
        </div>

        @if (RecentAttendances?.Any() == true)
        {
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Recent Attendance Records</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Hours Worked</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attendance in RecentAttendances)
                                {
                                    <tr>
                                        <td>@attendance.Date.ToString("yyyy-MM-dd")</td>
                                        <td>@attendance.CheckIn.ToString("HH:mm")</td>
                                        <td>@(attendance.CheckOut?.ToString("HH:mm") ?? "-")</td>
                                        <td>@attendance.HoursWorked.ToString("F2")</td>
                                        <td>
                                            @if (attendance.IsLate)
                                            {
                                                <span class="badge bg-warning">Late</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">On Time</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Employee>? Employees { get; set; }
    private int SelectedEmployeeId { get; set; }
    private Attendance NewAttendance { get; set; } = new Attendance();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private string? DebugMessage { get; set; }
    private bool IsSaving { get; set; }
    private List<Attendance>? RecentAttendances { get; set; }

    private DateTime? DateValue { get; set; }
    private TimeOnly? CheckInValue { get; set; }
    private TimeOnly? CheckOutValue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await EmployeeService.GetAllEmployees();
            if (response.StatusCode == 200)
            {
                Employees = response.Data;
            }
        }
        catch (DbUpdateException ex)
        {
            ErrorMessage = "Database connection error. Please check if MySQL is running.";
            DebugMessage = $"Database Error: {ex.Message}\nInner Exception: {ex.InnerException?.Message}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load employees.";
            DebugMessage = ex.Message;
        }
    }

    private async Task SaveAttendance()
    {
        if (IsSaving) return;

        ErrorMessage = null;
        SuccessMessage = null;
        DebugMessage = null;
        IsSaving = true;

        try
        {
            if (SelectedEmployeeId == 0)
            {
                ErrorMessage = "Please select an employee.";
                return;
            }

            if (!DateValue.HasValue)
            {
                ErrorMessage = "Please select a date.";
                return;
            }

            if (!CheckInValue.HasValue)
            {
                ErrorMessage = "Please enter check-in time.";
                return;
            }

            if (CheckOutValue.HasValue && CheckOutValue.Value <= CheckInValue.Value)
            {
                ErrorMessage = "Check-out time must be after check-in time.";
                return;
            }

            NewAttendance.EmployeeId = SelectedEmployeeId;
            NewAttendance.Date = DateValue.Value;
            NewAttendance.CheckIn = CheckInValue.Value;
            NewAttendance.CheckOut = CheckOutValue;

            DebugMessage = $"Attempting to save attendance for Employee {SelectedEmployeeId} on {DateValue.Value:yyyy-MM-dd}";
            
            await AttendanceService.AddAttendance(NewAttendance);

            SuccessMessage = "Attendance record saved successfully!";
            
            // Load recent attendance records
            RecentAttendances = await AttendanceService.GetAttendancesByEmployeeId(SelectedEmployeeId);
            
            // Reset form
            ResetForm();
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
            DebugMessage = $"Validation Error: {ex.Message}";
        }
        catch (DbUpdateException ex)
        {
            ErrorMessage = "Database error occurred while saving attendance.";
            DebugMessage = $"Database Error: {ex.Message}\nInner Exception: {ex.InnerException?.Message}";
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred while saving the attendance record.";
            DebugMessage = $"Unexpected Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void ResetForm()
    {
        NewAttendance = new Attendance();
        SelectedEmployeeId = 0;
        DateValue = null;
        CheckInValue = null;
        CheckOutValue = null;
    }
}